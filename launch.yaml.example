# Copy to launch.yaml and edit paths for your machine.
LAUNCHER_ROOT: "C:/Users/you/AppData/Local/Programs/fa-emu-launcher"
GAME_PATH: "G:/Games/FA/FA-EMU/Shipping/GAME.exe"
# Optional: TheGame repo root (build/msvc-x86-*/bin/TheGame.dll). Default: parent of GameController.
DLL_BUILD_ROOT: "C:/path/to/TheGame"
